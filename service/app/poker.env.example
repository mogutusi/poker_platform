# 游戏可调参数 —— 单一事实源(见 docs/config.md)。
#
# 本文件(poker.env.example)是提交进 git 的基线:app/gameconfig.py 启动期读它建 GameConfig。
# 本地调参:复制为 service/app/poker.env(gitignored)改值即可,poker.env 覆盖本文件、无需全量重抄。
# 改任何字段后,把改动同步回本 example(提交的是 example,不是 poker.env)。
# 基础设施配置(DATABASE_URL / JWT…)不在这里,走 service/.env + app/config.py(另一轨,见 docs/dev.md)。

# ── 定时器(timer.md)──
ACTION_TIMEOUT=15            # 行动倒计时(秒)
LIVENESS_TIMEOUT=90          # 在线保活(秒);须 ≫ ACTION_TIMEOUT
TIMER_TICK_MS=500           # Timer 扫描周期(毫秒)

# ── 背压(architecture.md)──
INBOX_MAX=1024              # GameLoop inbox 上限
OUTBOUND_MAX=256            # 每连接 outbound 上限
ERROR_DETAIL_MAX_LEN=200    # 回发 ErrorMessage.detail 最大字符数

# ── 房聊文本防护 / 限速(messaging.md)──
ROOM_CHAT_MAX_TEXT_LEN=500  # 房聊单条正文最大字符数
ROOM_CHAT_RATE_BURST=5      # 令牌桶容量(突发上限)
ROOM_CHAT_RATE_PER_SEC=1    # 令牌桶稳态补充速率(每秒可发条数)
ROOM_CHAT_HISTORY_SIZE=50   # 每房房聊环形缓冲条数

# ── 私信 DM 文本防护 / 限速(messaging.md §私信)──
DM_MAX_TEXT_LEN=1000        # 私信单条正文最大字符数
DM_RATE_BURST=5             # 私信令牌桶容量(突发上限)
DM_RATE_PER_SEC=1           # 私信令牌桶稳态补充速率(每秒可发条数)

# ── 日志(log.md)──
LOG_LEVEL=INFO              # DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_FORMAT=console          # json(生产)/ console(本地)
# LOG_FILE:落地文件路径;留空=只写 stderr(空值后不能跟行内注释,python-dotenv 会把注释当值)
LOG_FILE=

# ── delayDB 写回(db.md)──
DB_FLUSH_INTERVAL_MS=500    # PersistWriter 落库周期(毫秒)
DB_WRITE_MAX_RETRY=10       # 同批连续落库失败达此次数 → 毒丸丢批 + CRITICAL
DB_DRAIN_TIMEOUT_MS=5000    # 优雅关闭 drain 上限(毫秒)
DM_READ_RETENTION_SECONDS=604800   # 已读私信再留多久(秒)后清(7 天);未读永不删
DM_CLEANUP_INTERVAL_SECONDS=3600   # 私信保留清理周期(秒;每小时)

# ── 房间参数配置上下限(SetSmallBlind/SetBuyIn 合法区间;changes/0043)──
MIN_SMALL_BLIND=1          # 改小盲下限(≥1)
MAX_SMALL_BLIND=100000     # 改小盲上限
MIN_BUY_IN=1               # 改房间默认买入下限
MAX_BUY_IN=100000000       # 改房间默认买入上限

# ── 鉴权(auth.md;P5 国密安全信道)──
PWD_HASH_ROUNDS=100000     # 密码哈希 SM3 迭代轮数(拉伸抬高暴力成本;SM3 numba 实测 100k≈0.16s/次)
WS_FRAME_MAX_BYTES=65536   # 逐帧信道单帧字节上限(64KB;wire JSON 小帧足够,拒超大帧)
SESSION_TTL_SECONDS=3600   # ws 会话 token 有效期(秒;1 小时,客户端到期前无感轮换)
REST_FRAME_MAX_BYTES=65536 # REST 加密信封字节上限(64KB;与 ws 帧同量级,拒超大信封)
REST_REPLAY_WINDOW=64      # REST 防重放滑动窗宽度(容忍 64 深的并发/乱序请求,更旧一律拒)
LOGIN_REPLAY_WINDOW_SECONDS=120 # 登录包新鲜窗 W(秒;|now-blob.ts| 超 W 拒,nonce 去重条目 TTL=2W)

# ── REST 查询(rest.md;changes/0050/0051)──
LEADERBOARD_DEFAULT_LIMIT=20   # GET /leaderboard 不带 limit 时默认返回条数
LEADERBOARD_MAX_LIMIT=100      # GET /leaderboard limit 上限(防超大查询)
HANDS_DEFAULT_LIMIT=50         # GET /hands 不带 limit 时默认返回条数(一页手牌)
HANDS_MAX_LIMIT=200            # GET /hands limit 上限

# ── dev 房(明文 dev 脚手架,非生产;changes/0018)──
DEV_ROOM=dev                # dev 端点预置房名
DEV_SMALL_BLIND=1           # dev 房小盲(大盲 = 2×)
DEV_BUY_IN=100              # dev 房默认买入额
DEV_SEATS=6                 # dev 房座位数
DEV_USERS=["alice","bob","carol","dave","eve","frank"]   # 预置 dev 用户名(JSON 数组;?nick= 取其一)
DEV_START_POINTS=1000       # 每个 dev 用户初始全局积分
DEV_PASSWORD=devpass123     # dev 用户共享登录口令(dev-only,非生产;changes/0060)
DEV_KUSER=00112233445566778899aabbccddeeff   # dev 用户共享 SM4 密钥(32 hex=16B;dev-only,非生产)
